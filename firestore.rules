rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isResponder() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['As Rescuer', 'Both'];
    }
    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','fullName','email','phone','role','isResponderOnline','createdAt','profileVersion','fcmToken','fcmTokenUpdatedAt']);
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','email','phone','isResponderOnline','fcmToken','fcmTokenUpdatedAt']);
      allow delete: if false;
    }
    match /responders/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && isResponder()
        && request.resource.data.keys().hasOnly(['uid','online','updatedAt','location','fcmToken']);
      allow delete: if false;
    }
    match /emergencies/{id} {
      allow create: if signedIn()
        && request.resource.data.helpSeekerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['helpSeekerUid','type','description','doNotCall','status','location','locationAccuracyM','createdAt','updatedAt','acceptedBy']);
      allow read: if signedIn() && (resource.data.helpSeekerUid == request.auth.uid || isResponder());
      allow update: if signedIn() && isResponder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy','status','updatedAt'])
        && (resource.data.status == 'open' || resource.data.acceptedBy == request.auth.uid);
      allow delete: if false;
      match /liveLocations/{uid} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/emergencies/$(id)).data.helpSeekerUid == request.auth.uid || isResponder());
        allow create, update: if isOwner(uid) && isResponder()
          && request.resource.data.keys().hasOnly(['uid','location','accuracyM','updatedAt']);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
