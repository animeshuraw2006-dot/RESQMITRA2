# Copy to .env for local testing. Never commit .env or real credentials.
# Neon dashboard -> project -> Connect -> pooled PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Generate a strong random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Required for live SMS phone verification. Obtain from your Renflair account.
# This key must exist ONLY in backend environment variables.
RENFLAIR_API_KEY=replace-with-renflair-api-key

# Local development only. Render supplies PORT automatically; do not set it to blank.
PORT=8080

# Optional S3-compatible object storage. Leave all S3 values unset to use PostgreSQL bytea fallback.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
