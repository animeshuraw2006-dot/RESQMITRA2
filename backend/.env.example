# Copy to .env for local testing (never commit .env)
# Neon dashboard → your project → "Connect" → copy the POOLED connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Long random text. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Local only. On Render do NOT add a PORT variable - Render sets it automatically (a blank PORT breaks startup).
PORT=8080

# Optional S3-compatible object storage (Neon Object Storage or compatible endpoint).
# Leave all S3 values unset to keep the legacy PostgreSQL bytea fallback.
S3_ENDPOINT=https://YOUR-OBJECT-STORAGE-ENDPOINT
S3_REGION=auto
S3_BUCKET=assets
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
