# Copy to .env for local testing (never commit .env)
# Neon dashboard → your project → "Connect" → copy the POOLED connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Long random text. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080
